{
  "name": "@persike/dsh-njord-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Docker, Treadmill, Knowledge and Archify panels for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevViking-Persike/dsh-njord-ui.git"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/package.test.mjs",
    "test:sdk": "node scripts/test-sdk.mjs",
    "typecheck:sdk": "node scripts/typecheck-sdk.mjs"
  },
  "dependencies": {
    "@persike/dsh-project-tools": "git+https://github.com/DevViking-Persike/dsh-project-tools.git#86f22e087815b049d1f2f1e37c2ca04271a539ec",
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.1.6-alpha.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "lightningcss": "^1.30.0",
    "jsdom": "^29.0.0",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "react-dom": "^18.3.1",
    "vitest": "^4.1.8",
    "@testing-library/react": "^16.3.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
